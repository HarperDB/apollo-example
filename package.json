{
  "name": "apollo-example",
  "version": "1.0.1",
  "description": "A template for building Harper applications",
  "type": "module",
  "scripts": {
    "test": "HARPER_INTEGRATION_TEST_INSTALL_SCRIPT=./node_modules/harper/dist/bin/harper.js harper-integration-test-run --isolation=none \"integrationTests/**/*.test.ts\"",
    "test:integration": "harper-integration-test-run --isolation=none \"integrationTests/**/*.test.ts\""
  },
  "dependencies": {
    "@harperdb/apollo": "^1.1.0",
    "harper": "^5.2.1"
  },
  "devDependencies": {
    "@harperfast/integration-testing": "^0.3.1",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
